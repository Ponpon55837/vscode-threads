{
  "name": "vscode-threads-plugin",
  "displayName": "Threads Explorer Phase 1 Spike",
  "description": "Personal-mode Threads OAuth, URI callback, and keyword search feasibility spike.",
  "version": "0.0.1",
  "publisher": "dgh",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onUri"],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "threadsExplorer.setupPersonalMode", "category": "Threads Explorer", "title": "Setup Personal Mode" },
      { "command": "threadsExplorer.signIn", "category": "Threads Explorer", "title": "Sign in with Threads" },
      { "command": "threadsExplorer.keywordSearch", "category": "Threads Explorer", "title": "Search Threads by Keyword" },
      { "command": "threadsExplorer.testStaticCallback", "category": "Threads Explorer", "title": "Test Static Callback" },
      { "command": "threadsExplorer.disconnect", "category": "Threads Explorer", "title": "Disconnect Account" },
      { "command": "threadsExplorer.resetPersonalMode", "category": "Threads Explorer", "title": "Reset Personal Mode" }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve:callback": "node scripts/serve-callback.js",
    "package": "vsce package --out dist/threads-explorer-poc.vsix --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
